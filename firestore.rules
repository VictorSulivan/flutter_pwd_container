rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Un nœud par compte Auth. Pas de secret ici.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['kind']);
    }

    // Un coffre par user : sel + clé AES enveloppée. Pas le mot de passe maître.
    match /users/{userId}/enveloppe/{document} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'v',
          'kdf',
          'iterations',
          'salt',
          'wrappedDek',
          'updatedAt'
        ]);
    }

    // X fiches (sites / apps), chacune déjà chiffrée.
    match /users/{userId}/fiches/{ficheId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['ciphertext', 'updatedAt']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
